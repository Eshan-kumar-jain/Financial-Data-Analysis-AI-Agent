		sourceColumn: method_name

		annotation SummarizationSetBy = Automatic

	column is_flagged
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 77fb07f2-9146-4a0e-ba34-561afd669664
		summarizeBy: none
		sourceColumn: is_flagged

		annotation SummarizationSetBy = Automatic

	column is_covered
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 5a467a8d-4ec8-4c17-a1ad-d8bb19fbed6c
		summarizeBy: none
		sourceColumn: is_covered

		annotation SummarizationSetBy = Automatic

	column score
