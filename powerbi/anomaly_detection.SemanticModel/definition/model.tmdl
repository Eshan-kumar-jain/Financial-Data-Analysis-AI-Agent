model Model
	culture: en-IN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-IN
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["public dim_account","public dim_date","public dim_employee","public eval_entry","public eval_entry_flag","public eval_entry_label","public eval_method","public eval_method_score","public eval_threshold_sweep"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table dim_date
ref table dim_employee
ref table eval_entry
ref table eval_entry_flag
ref table eval_entry_label
ref table eval_method
ref table eval_method_score
ref table eval_threshold_sweep

ref cultureInfo en-IN

